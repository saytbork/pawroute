# PawRoute environment variables
#
# The current prototype does not require external service credentials.
# These placeholders document the planned production integrations.
# Copy this file to .env.local when local backend work begins.
#
# Never commit real credentials.

# Application
APP_URL=http://localhost:3000

# Database / authentication
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Geocoding / routing
# MAPS_API_KEY=

# Payments - later phase
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=

# Transactional email - later phase
# RESEND_API_KEY=
# EMAIL_FROM=
