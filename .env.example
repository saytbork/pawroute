# PawRoute environment variables (server-side only unless noted).
# Copy real values into Project Settings -> Secrets; never commit real secrets.

# --- Business configuration (no secrets) ---
APP_MODE=demo                      # "production" disables the sample-flow pages and shows setup warnings
BUSINESS_NAME=PawRoute Mobile Grooming
BUSINESS_PHONE=204-555-0100
BUSINESS_CITY=Winnipeg, MB
BUSINESS_TIMEZONE=America/Winnipeg
BUSINESS_BASE_ADDRESS=             # optional: home base for route travel estimates
OWNER_FIRST_NAME=Maya
PRIVACY_EMAIL=privacy@example.com
SERVICE_AREA_PREFIXES=R2C,R2H,R2J,R2K,R2M,R2N,R2V,R2W,R3A,R3B,R3C,R3E,R3H,R3J,R3K,R3L,R3M,R3N,R3P,R3R,R3T,R3V,R3X,R3Y
PUBLIC_SITE_URL=http://localhost:8080

# --- Route optimization (optional; without it travel time is never invented) ---
MAPBOX_ACCESS_TOKEN=

# --- Email delivery via Resend (optional; without it booking still saves, status is honest) ---
RESEND_API_KEY=
FROM_EMAIL=bookings@yourdomain.com

# --- Cron for reminders (idempotent; callers must send the x-cron-secret header) ---
CRON_SECRET=